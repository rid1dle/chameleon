{
 "name": "P2 controlled zone (lab.riddlelab.dev, Free plan), runner defaults: redirects 5, cookie jar, 3 attempts with backoff and Retry-After; circuit breaker only in the breaker-* cases (the matrix fails on purpose)",
 "delay_ms": 1500,
 "clients": [
  {
   "name": "cfprobe",
   "kind": "cfprobe"
  },
  {
   "name": "cfprobe-h1-titlecase",
   "kind": "cfprobe",
   "config": {
    "tls": {
     "alpn": [
      "http/1.1"
     ]
    },
    "h1": {
     "title_case_headers": true
    }
   }
  },
  {
   "name": "curl",
   "kind": "curl"
  }
 ],
 "cases": [
  {
   "id": "echo",
   "category": "normal",
   "description": "Worker echo JSON, no rule",
   "url": "https://lab.riddlelab.dev/echo",
   "expect": {
    "status": 200,
    "verdict": "NORMAL_PAGE"
   }
  },
  {
   "id": "echo-html",
   "category": "normal",
   "description": "Worker echo as an HTML page (where JS Detections would be injected)",
   "url": "https://lab.riddlelab.dev/echo?html=1",
   "headers": [
    [
     "accept",
     "text/html"
    ]
   ],
   "expect": {
    "status": 200,
    "verdict": "NORMAL_PAGE"
   }
  },
  {
   "id": "echo-compressed",
