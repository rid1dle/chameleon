# Copy to .env (gitignored) and fill in. Zone and account IDs are looked up from the zone name,
# so the token is the only secret the scripts need.
#
# The token has to be able to make these calls (scripts/zone/*):
#   read the zone                        GET  /zones?name=...                       (up, down, fw_events)
#   edit WAF custom rules                /zones/:id/rulesets/phases/http_request_firewall_custom/...  (up, down)
#   edit Workers scripts                 /accounts/:id/workers/scripts/...          (up, down)
#   edit Workers Custom Domains          /accounts/:id/workers/domains              (up, down)
#   read zone analytics (GraphQL)        POST /graphql firewallEventsAdaptive       (fw_events)
# It does not need DNS permissions: the Custom Domain creates and removes its own DNS record.
CLOUDFLARE_API_TOKEN_KEY_TEST=

# Optional overrides (defaults shown)
# ZONE_NAME=riddlelab.dev
# LAB_HOST=lab.riddlelab.dev

# Optional proxy for every connection cfprobe, the zone scripts, authdns.py and solve.sh make.
# http://, https://, socks5:// or socks5h:// (socks5 is treated as socks5h: the proxy resolves names).
# Credentials may be in the URL; they are never printed. Unset: direct connections, announced.
# CFPROBE_PROXY=http://user:pass@127.0.0.1:18080
